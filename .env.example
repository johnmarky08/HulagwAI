APP_NAME=HulagwAI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# XAMPP MySQL/MariaDB. Create the database first:  CREATE DATABASE hulagwai CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# For production use a dedicated MySQL user with only the privileges this app needs - never root.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hulagwai
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true behind HTTPS (production)
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# HulagwAI ML service (Python / FastAPI, loopback only)
# ---------------------------------------------------------------------------
ML_SERVICE_URL=http://127.0.0.1:8001
# Shared secret between Laravel and the ML service (min 32 chars). Generate:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# Put the SAME value in ml-service/.env as ML_SERVICE_TOKEN.
ML_SERVICE_TOKEN=
ML_TIMEOUT=90

# Optional: reject passwords found in public breaches (needs internet, uses HIBP k-anonymity)
PASSWORD_CHECK_BREACHED=false

# ---------------------------------------------------------------------------
# Google sign-in (optional). Google Cloud Console > APIs & Services > Credentials
# > Create credentials > OAuth client ID > "Web application".
# Add GOOGLE_REDIRECT_URI exactly as written to "Authorized redirect URIs".
# Leave GOOGLE_CLIENT_ID empty to hide the "Continue with Google" button.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
