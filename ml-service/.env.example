# Copy to ml-service/.env  (never commit the real file)
# Must be IDENTICAL to ML_SERVICE_TOKEN in the Laravel .env (min 32 chars).
ML_SERVICE_TOKEN=
ML_HOST=127.0.0.1
ML_PORT=8001
# Folder containing the trained model bundle (config.json, *.safetensors, manifest.json, metrics.json)
ML_MODEL_DIR=models/current
# true  -> if no trained bundle is installed, still run the metadata/provenance check and answer
#          "inconclusive" for everything else (handy before you have trained the model).
# false -> the API answers 503 until a bundle exists (recommended for production).
ML_ALLOW_METADATA_ONLY=true
ML_MAX_CONCURRENCY=1
ML_TORCH_THREADS=4
# Set to 1 after the first run to forbid any network access for model files (open_clip weights are cached).
HF_HUB_OFFLINE=0
